#!/bin/sh
set -eu
# Installed beside the native executable; no Node, git, or npm launcher.
ai4science_prefix=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
# Wrapper-owned options must precede engine arguments; either order is accepted.
ai4science_pwm=0
ai4science_workspace=${AI4SCIENCE_WORKSPACE:-}
while [ "$#" -gt 0 ]; do
  case "$1" in
    --pwm) ai4science_pwm=1; shift ;;
    --workspace)
      [ "$#" -ge 2 ] && [ -n "$2" ] || { echo 'Usage: ai4science --workspace DIRECTORY [command] [arguments]' >&2; exit 2; }
      ai4science_workspace=$2; shift 2 ;;
    *) break ;;
  esac
done
case "${1:-}" in
  pwm)
    [ "$#" = 2 ] || { echo 'Usage: ai4science pwm login|logout' >&2; exit 2; }
    case "$2" in login|logout) ;; *) echo 'Usage: ai4science pwm login|logout' >&2; exit 2 ;; esac
    exec python3 -I "$ai4science_prefix/bin/pwm-config.py" "$ai4science_prefix" "$2" ;;
esac
# No helper or environment changes on the ordinary path unless restoring a prior opt-in.
if [ "$ai4science_pwm" = 1 ]; then
  python3 -I "$ai4science_prefix/bin/pwm-config.py" "$ai4science_prefix" on
elif [ -e "$ai4science_prefix/var/pwm/base-config" ]; then
  python3 -I "$ai4science_prefix/bin/pwm-config.py" "$ai4science_prefix" off
fi
if [ -n "$ai4science_workspace" ]; then
  ai4science_workspace=$(CDPATH= cd -- "$ai4science_workspace" 2>/dev/null && pwd -P) || { echo 'AI4Science workspace is not a directory.' >&2; exit 2; }
fi
ai4science_config="$ai4science_prefix/var/config/opencode"
umask 077
mkdir -p "$ai4science_config" "$ai4science_prefix/var/home" "$ai4science_prefix/var/managed"
if [ "$(uname -s)" = Darwin ]; then
  for ai4science_plist in "/Library/Managed Preferences/$(id -un)/ai.opencode.managed.plist" "/Library/Managed Preferences/ai.opencode.managed.plist"; do
    if [ -e "$ai4science_plist" ]; then
      echo 'AI4Science cannot isolate OpenCode managed preferences on this Mac. Ask your administrator to remove the OpenCode profile before using this wrapper.' >&2
      exit 1
    fi
  done
fi
# Discard the entire inherited upstream namespace, including future flags.
# Only the explicit AI4SCIENCE_* interface and private config are inputs.
# Separate assignments propagate utility failures before the engine can start.
ai4science_env_names=$(env)
ai4science_env_names=$(printf '%s\n' "$ai4science_env_names" | sed -n 's/^\(OPENCODE_[A-Za-z0-9_]*\)=.*/\1/p')
for ai4science_env in $ai4science_env_names; do
  unset "$ai4science_env"
done
unset ai4science_env_names
# The dedicated XDG roots isolate config AND stored auth, sessions, and caches.
export XDG_CONFIG_HOME="$ai4science_prefix/var/config"
export XDG_DATA_HOME="$ai4science_prefix/var/data"
export XDG_CACHE_HOME="$ai4science_prefix/var/cache"
export XDG_STATE_HOME="$ai4science_prefix/var/state"
export PATH="$ai4science_prefix/var/cache/opencode/bin:$PATH"
export OPENCODE_CONFIG_DIR="$ai4science_config"
export OPENCODE_CONFIG="$ai4science_config/opencode.json"
export OPENCODE_TEST_HOME="$ai4science_prefix/var/home"
export OPENCODE_TEST_MANAGED_CONFIG_DIR="$ai4science_prefix/var/managed"
export OPENCODE_DISABLE_PROJECT_CONFIG=1
export OPENCODE_DISABLE_AUTOUPDATE=1
export OPENCODE_DISABLE_MODELS_FETCH=1
export OPENCODE_DISABLE_DEFAULT_PLUGINS=1
export OPENCODE_DISABLE_CLAUDE_CODE=1
export OPENCODE_DISABLE_EXTERNAL_SKILLS=1
export OPENCODE_DISABLE_LSP_DOWNLOAD=1
export OPENCODE_DISABLE_FFF=1
export OPENCODE_DISABLE_TERMINAL_TITLE=1
export OPENCODE_EXPERIMENTAL=0
export OTEL_SDK_DISABLED=true
unset OTEL_EXPORTER_OTLP_ENDPOINT OTEL_EXPORTER_OTLP_HEADERS
unset HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
export npm_config_userconfig="$ai4science_prefix/empty-user.npmrc"
export npm_config_globalconfig="$ai4science_prefix/empty-global.npmrc"
export npm_config_cache="$ai4science_prefix/var/npm-cache"
export npm_config_registry=https://registry.npmjs.org
export npm_config_offline=true
if [ "${AI4SCIENCE_INSTALL_DEPENDENCIES:-0}" = 1 ]; then
  export npm_config_offline=false
fi
export AI4SCIENCE_BASE_URL=${AI4SCIENCE_BASE_URL:-http://127.0.0.1:8000/v1}
export AI4SCIENCE_API_KEY=${AI4SCIENCE_API_KEY:-local-no-key}
export AI4SCIENCE_MODEL=${AI4SCIENCE_MODEL:-local}
# `serve` is password-protected only through our own variable (all OPENCODE_* were cleared above).
if [ -n "${AI4SCIENCE_SERVER_PASSWORD:-}" ]; then
  export OPENCODE_SERVER_PASSWORD="$AI4SCIENCE_SERVER_PASSWORD"
  export OPENCODE_SERVER_USERNAME="${AI4SCIENCE_SERVER_USERNAME:-opencode}"
fi
unset AI4SCIENCE_SERVER_PASSWORD
# Where the session works. Project settings stay off unless AI4SCIENCE_PROJECT_CONFIG=1.
# - --workspace DIR: the session works in DIR. The pinned engine's v2 loader still opens
#   opencode.json/.opencode files from DIR up to the project root, for experimental.policies only;
#   providers, models, instructions, plugins, agents and MCP from them are not loaded.
# - AI4SCIENCE_PROJECT_CONFIG=1: the current folder, with its settings (explicit trust).
# - neither: the private config folder, the one place the v2 loader reads no project files.
if [ -n "$ai4science_workspace" ]; then
  cd -- "$ai4science_workspace"
  [ "${AI4SCIENCE_PROJECT_CONFIG:-0}" != 1 ] || export OPENCODE_DISABLE_PROJECT_CONFIG=0
elif [ "${AI4SCIENCE_PROJECT_CONFIG:-0}" = 1 ]; then
  export OPENCODE_DISABLE_PROJECT_CONFIG=0
else
  cd -- "$ai4science_config"
fi
export PWD="$(pwd -P)"
for ai4science_arg do
  case "$ai4science_arg" in
    # Stop at another command so a run prompt can literally be "upgrade".
    acp|mcp|attach|run|generate|debug|console|auth|providers|agent|uninstall|serve|web|models|stats|export|import|github|pr|session|plugin|db|completion) break ;;
    upgrade) echo 'AI4Science uses a pinned engine. Update the reviewed wrapper package to upgrade.' >&2; exit 2 ;;
  esac
done
case "${1:-}" in
  --version|-v) ai4science_version=$("$ai4science_prefix/bin/opencode" --version); printf 'AI4Science common mode (OpenCode %s)\n' "$ai4science_version"; exit ;;
esac
exec "$ai4science_prefix/bin/opencode" "$@"
